{
  "name": "codemarket-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "prisma": {
    "schema": "../prisma/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:watermark": "tsx --test test/watermarkedArchive.test.ts",
    "test:local-e2e": "tsx --test test/local-workflows.e2e.ts",
    "owner:rotate-password": "tsx src/rotateOwnerPassword.ts",
    "seed:owner": "tsx src/seedOwner.ts",
    "db:deploy": "node ../scripts/prisma.mjs migrate deploy --schema ../prisma/schema.prisma",
    "db:generate": "node ../scripts/prisma.mjs generate --schema ../prisma/schema.prisma",
    "db:push": "node ../scripts/prisma.mjs db push --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.10.0",
    "uuid": "^11.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.1",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
